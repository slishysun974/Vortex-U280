.version 7.0
.target sm_70
.address_size 64
.visible .entry predicate_turn(.param .u64 x, .param .u64 y, .param .u64 z,
                               .param .u32 n, .param .u32 selected) {
    .reg .b64 px, py, pz, off;
    .reg .b32 lane, width, cta, idx, count, pick, value;
    .reg .pred active;
    ld.param.u64 px, [x];
    ld.param.u64 py, [y];
    ld.param.u64 pz, [z];
    ld.param.u32 count, [n];
    ld.param.u32 pick, [selected];
    mov.u32 lane, %tid.x;
    mov.u32 cta, %ctaid.x;
    mov.u32 width, %ntid.x;
    mul.lo.u32 idx, cta, width;
    add.u32 idx, idx, lane;
    mul.wide.u32 off, idx, 4;
    add.u64 px, px, off;
    add.u64 py, py, off;
    add.u64 pz, pz, off;
    mov.u32 value, 0;
    setp.lt.u32 active, idx, count;
    @active ld.global.u32 value, [px];
    @active add.u32 value, value, 1;
    @active st.global.u32 [pz], value;
    @!active ld.global.u32 value, [py];
    @!active sub.u32 value, value, 1;
    @!active st.global.u32 [pz], value;
    setp.eq.u32 active, lane, pick;
    @active ld.global.u32 value, [pz];
    @active add.u32 value, value, 0x80000001;
    @active st.global.u32 [pz], value;
    ret;
}
