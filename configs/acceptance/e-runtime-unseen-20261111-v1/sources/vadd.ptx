.version 7.0
.target sm_70
.address_size 64
.visible .entry vadd_u32(.param .u64 x, .param .u64 y, .param .u64 z, .param .u32 n) {
  .reg .pred %p;
  .reg .b32 %r<7>;
  .reg .b64 %a<7>;
  ld.param.u64 %a0, [x];
  ld.param.u64 %a1, [y];
  ld.param.u64 %a2, [z];
  ld.param.u32 %r0, [n];
  mov.u32 %r1, %ctaid.x;
  mov.u32 %r2, %ntid.x;
  mul.lo.u32 %r1, %r1, %r2;
  mov.u32 %r2, %tid.x;
  add.u32 %r1, %r1, %r2;
  setp.lt.u32 %p, %r1, %r0;
  mul.wide.u32 %a3, %r1, 4;
  add.u64 %a4, %a0, %a3;
  add.u64 %a5, %a1, %a3;
  add.u64 %a6, %a2, %a3;
  @%p ld.global.u32 %r3, [%a4];
  @%p ld.global.u32 %r4, [%a5];
  @%p add.u32 %r5, %r3, %r4;
  @%p st.global.u32 [%a6], %r5;
  ret;
}
