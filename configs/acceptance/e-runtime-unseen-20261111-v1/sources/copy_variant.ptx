.version 7.0
.target sm_70
.address_size 64
.visible .entry e_november_copy(.param .u64 x, .param .u64 z, .param .u32 n) {
  .reg .pred %outside;
  .reg .b32 %evalue<5>;
  .reg .b64 %eptr<5>;
  ld.param.u64 %eptr0, [x];
  ld.param.u64 %eptr1, [z];
  ld.param.u32 %evalue0, [n];
  mov.u32 %evalue1, %ctaid.x;
  mov.u32 %evalue2, %ntid.x;
  mul.lo.u32 %evalue1, %evalue1, %evalue2;
  mov.u32 %evalue2, %tid.x;
  add.u32 %evalue1, %evalue1, %evalue2;
  setp.ge.u32 %outside, %evalue1, %evalue0;
  mul.wide.u32 %eptr2, %evalue1, 0x4U;
  cvta.to.global.u64 %eptr0, %eptr0;
  cvta.to.global.u64 %eptr1, %eptr1;
  add.u64 %eptr3, %eptr0, %eptr2;
  add.u64 %eptr4, %eptr1, %eptr2;
  @!%outside ld.global.u32 %evalue3, [%eptr3];
  @!%outside sub.u32 %evalue3, %evalue3, 0;
  @!%outside st.global.u32 [%eptr4], %evalue3;
  ret;
}
