.version 7.0
.target sm_70
.address_size 64
.visible .entry e_november_affine(.param .u64 x, .param .u64 y, .param .u64 z, .param .u32 n, .param .u32 alpha) {
  .reg .pred %outside;
  .reg .b32 %evalue<8>;
  .reg .b64 %eptr<7>;
  ld.param.u64 %eptr0, [x];
  ld.param.u64 %eptr1, [y];
  ld.param.u64 %eptr2, [z];
  ld.param.u32 %evalue0, [n];
  ld.param.u32 %evalue7, [alpha];
  mov.u32 %evalue1, %ctaid.x;
  mov.u32 %evalue2, %ntid.x;
  mul.lo.u32 %evalue1, %evalue1, %evalue2;
  mov.u32 %evalue2, %tid.x;
  add.u32 %evalue1, %evalue1, %evalue2;
  setp.ge.u32 %outside, %evalue1, %evalue0;
  mul.wide.u32 %eptr3, %evalue1, 0x4U;
  add.u64 %eptr4, %eptr0, %eptr3;
  add.u64 %eptr5, %eptr1, %eptr3;
  add.u64 %eptr6, %eptr2, %eptr3;
  @!%outside ld.global.u32 %evalue3, [%eptr4];
  @!%outside ld.global.u32 %evalue4, [%eptr5];
  @!%outside mul.lo.u32 %evalue5, %evalue7, %evalue3;
  @!%outside add.u32 %evalue6, %evalue5, %evalue4;
  @!%outside mul.lo.u32 %evalue6, %evalue6, 1;
  @!%outside st.global.u32 [%eptr6], %evalue6;
  ret;
}
